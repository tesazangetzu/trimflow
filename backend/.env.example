# ─── Aplicación ───
NODE_ENV=development
PORT=3000
API_PREFIX=v1

# ─── Base de datos ───
DATABASE_URL=postgresql://trimflow:trimflow@localhost:5432/trimflow

# ─── Redis ───
REDIS_URL=redis://default:redispass@localhost:6379

# ─── JWT ───
JWT_SECRET=change_me_min_32_characters_long_secret
JWT_REFRESH_SECRET=change_me_min_32_characters_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ───
CORS_ORIGINS=*

# ─── Logging ───
LOG_LEVEL=debug

# ─── SMTP (opcional) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── Sentry (opcional) ───
SENTRY_DSN=

# ─── Multi-tenant ───
TENANT_DB_SCHEMA_PREFIX=tenant_

# ─── Rate Limiting ───
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ─── Cloudflare R2 ───
# Account ID de Cloudflare (panel R2 > Overview > Account ID)
R2_ACCOUNT_ID=change_me_account_id
# Access Key ID / Secret del token R2 (R2 > Manage R2 API Tokens)
R2_ACCESS_KEY_ID=change_me_access_key_id
R2_SECRET_ACCESS_KEY=change_me_secret_access_key
# Nombre del bucket R2 donde se almacenan las imágenes
R2_BUCKET=trimflow-images
# Base URL pública del bucket (custom domain). Opcional: si no se define,
# se deriva https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_URL=
