# ─── Aplicación ───
NODE_ENV=development
PORT=3000
API_PREFIX=v1

# ─── Base de datos ───
DATABASE_URL=postgresql://trimflow:trimflow@localhost:5432/trimflow

# ─── Redis ───
REDIS_URL=redis://default:redispass@localhost:6379

# ─── JWT ───
JWT_SECRET=change_me_min_32_characters_long_secret
JWT_REFRESH_SECRET=change_me_min_32_characters_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ───
CORS_ORIGINS=*

# ─── Logging ───
LOG_LEVEL=debug

# ─── SMTP (opcional) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── Sentry (opcional) ───
SENTRY_DSN=

# ─── Multi-tenant ───
TENANT_DB_SCHEMA_PREFIX=tenant_

# ─── Rate Limiting ───
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
